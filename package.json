{
  "name": "azure-vision",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.2.2 <13"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "vitest run",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p web --noEmit",
    "icons": "node scripts/import-icons.mjs",
    "k8s:up": "scripts/k8s.sh up",
    "k8s:redeploy": "scripts/k8s.sh redeploy",
    "k8s:forward": "scripts/k8s.sh forward",
    "k8s:down": "scripts/k8s.sh down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
